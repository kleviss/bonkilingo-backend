OPENAI_API_KEY=key_here
PORT=3001

# --- AI endpoint protection (optional, defaults shown) ---
# Requests per hour per signed-in user, per endpoint (language detection gets 5x).
AI_REQUESTS_PER_HOUR=120
# Requests per hour per IP without sign-in (in memory, per instance). 0 = sign-in required.
ANON_AI_REQUESTS_PER_HOUR=20
# Longest text accepted by /api/correct and /api/detect-language.
MAX_TEXT_CHARS=5000
# Browser origins allowed to call this API, comma-separated. Empty = none (the mobile app doesn't need CORS).
CORS_ORIGINS=
# Proxy hops to trust for client IPs. Defaults to 1 on Vercel, off elsewhere.
# TRUST_PROXY=1
